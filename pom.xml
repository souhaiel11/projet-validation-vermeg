<?xml version="1.0" encoding="UTF-8"?>
<!-- ════════════════════════════════════════════════════════════════════════════
     PROJET DE VALIDATION VERMEG
     APPLICATION INTENTIONNELLEMENT VULNÉRABLE — BANC D'ESSAI UNIQUEMENT.
     Ne jamais déployer hors d'un environnement de test isolé.

     Ce descripteur est volontairement SANS DÉFAUT : il doit fonctionner
     parfaitement, car c'est lui que la chaîne de remédiation va modifier.
     Les défauts du projet sont ailleurs — dans les versions de dépendances,
     dans le Dockerfile, dans le Jenkinsfile et dans le code source.

     Aucun parent : un parent introduirait une gestion de version par BOM,
     c'est-à-dire exactement la provenance que la plateforme refuse
     d'auto-corriger (BOM_MANAGED → ADMIN_ACTION_REQUIRED).
     Un seul pom, à la racine : l'adaptateur de cible de la plateforme
     n'ancre que le descripteur racine, jamais un module enfant.
     Voir docs/MATRICE_VALIDATION.md.
     ════════════════════════════════════════════════════════════════════════ -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>tn.vermeg.validation</groupId>
  <artifactId>projet-validation-vermeg</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>projet-validation-vermeg</name>
  <description>PROJET DE VALIDATION INTENTIONNELLEMENT VULNERABLE — BANC D'ESSAI UNIQUEMENT</description>

  <properties>
    <!-- 17 est la seule valeur qui passe des deux côtés : le vérificateur de
         candidats compile en JDK 17, Jenkins en JDK 21. -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-10-19T00:00:00Z</project.build.outputTimestamp>

    <!-- Chemin du rapport JaCoCo, lu par le scanner Sonar. Sans cette propriété,
         Sonar affiche 0 % de couverture : exact, mais trompeur. -->
    <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>

    <!-- ╔══════════════════════════════════════════════════════════════════╗
         ║ VAL-D02 — dépendance gérée par PROPRIÉTÉ LOCALE                  ║
         ║ Provenance PROPERTY_MANAGED : la plateforme doit corriger CETTE  ║
         ║ propriété, pas une version écrite en dur dans <dependency>.      ║
         ╚══════════════════════════════════════════════════════════════════╝ -->
    <commons-lang3.version>3.12.0</commons-lang3.version>
  </properties>

  <dependencies>

    <!-- ╔══════════════════════════════════════════════════════════════════╗
         ║ VAL-D01 — AUTO-CORRIGEABLE · provenance DIRECT_EXPLICIT          ║
         ║ h2 2.1.212 porte CVE-2022-45868 (HIGH), corrigée en 2.2.220.     ║
         ║ Même majeure (2.x) → dans l'enveloppe auto-corrigeable.          ║
         ║ Usage authentique : la valorisation du portefeuille est calculée ║
         ║ par agrégation SQL en mémoire (ValorisationPortefeuille).        ║
         ║ Périmètre de sûreté : base strictement en mémoire, aucune        ║
         ║ console H2, aucune URL fournie par l'appelant, requêtes          ║
         ║ préparées uniquement, aucun SQL construit depuis une entrée.     ║
         ╚══════════════════════════════════════════════════════════════════╝ -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.1.212</version>
    </dependency>

    <!-- VAL-D02 — pilotée par ${commons-lang3.version} déclarée ci-dessus.
         3.12.0 porte CVE-2025-48924 (MEDIUM), corrigée en 3.18.0, même majeure. -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>${commons-lang3.version}</version>
    </dependency>

    <!-- ╔══════════════════════════════════════════════════════════════════╗
         ║ VAL-D03 — AUTO-CORRIGEABLE · provenance DIRECT_EXPLICIT          ║
         ║ commons-io 2.6 porte CVE-2021-29425 (traversée de chemin),       ║
         ║ corrigée en 2.7 — même majeure.                                  ║
         ║ Troisième positif : il prouve que la correction n'est pas câblée ║
         ║ sur une dépendance particulière.                                 ║
         ╚══════════════════════════════════════════════════════════════════╝ -->
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.6</version>
    </dependency>

    <!-- ╔══════════════════════════════════════════════════════════════════╗
         ║ VAL-D04 — REFUS ATTENDU · CROSS_MAJOR_ONLY                       ║
         ║ snakeyaml 1.33 porte CVE-2022-1471, dont la SEULE correction est ║
         ║ la version 2.0 — majeure supérieure.                             ║
         ║ La politique de sélection ne retient qu'une version corrigée de  ║
         ║ MÊME majeure : elle renvoie donc une cible nulle et refuse.      ║
         ║ Le refus ne vient PAS d'une absence de correctif — il en existe  ║
         ║ un — mais du franchissement de majeure, qui exige un humain.     ║
         ╚══════════════════════════════════════════════════════════════════╝ -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>1.33</version>
    </dependency>

    <!-- ╔══════════════════════════════════════════════════════════════════╗
         ║ VAL-D05 — REFUS ATTENDU · TRANSITIVE_NOT_AUTOFIXABLE_V1          ║
         ║ commons-configuration2 2.8.0 entraîne commons-text 1.9 en        ║
         ║ TRANSITIF. commons-text 1.9 porte CVE-2022-42889 « Text4Shell »  ║
         ║ (CRITICAL, CVSS 9.8), corrigée en 1.10.0 — MÊME MAJEURE.         ║
         ║                                                                  ║
         ║ C'est le contre-exemple le plus instructif du projet : la même   ║
         ║ CVE, avec un correctif de même majeure disponible, serait        ║
         ║ auto-corrigée si la dépendance était déclarée en direct. Elle    ║
         ║ est refusée ici uniquement parce qu'elle arrive par transitivité.║
         ║ Le refus porte sur la PROVENANCE, pas sur la disponibilité d'un  ║
         ║ correctif.                                                       ║
         ║                                                                  ║
         ║ L'application n'appelle PAS l'interpolateur vulnérable           ║
         ║ (StringSubstitutor.createInterpolator) : la dépendance est       ║
         ║ présente et réellement utilisée, le chemin exploitable ne l'est  ║
         ║ pas.                                                             ║
         ╚══════════════════════════════════════════════════════════════════╝ -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-configuration2</artifactId>
      <version>2.8.0</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Versions de plugin toutes épinglées : sans cela Maven résout des
           versions par défaut qui varient entre Jenkins (3.6.3) et le
           vérificateur de candidats (3.8.7), et le build cesse d'être
           reproductible d'un côté à l'autre. -->
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-clean-plugin</artifactId><version>3.2.0</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.11.0</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-install-plugin</artifactId><version>3.1.1</version></plugin>

      <!-- Couverture réelle, pour que SonarQube affiche un pourcentage mesuré
           plutôt que 0 % faute de rapport importé. Aucun seuil n'est imposé. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution><id>prepare-agent</id><goals><goal>prepare-agent</goal></goals></execution>
          <execution><id>report</id><phase>test</phase><goals><goal>report</goal></goals></execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- Un build sans test exécuté doit échouer, pas réussir en silence :
               la plateforme ne doit jamais lire « 0 test, 0 échec » comme un
               succès. C'est la traduction en Maven de l'exigence ENF-07. -->
          <failIfNoTests>true</failIfNoTests>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive><manifest><mainClass>tn.vermeg.validation.App</mainClass></manifest></archive>
        </configuration>
      </plugin>

      <!-- CONTRAT D'INTÉGRATION — ne pas retirer.
           La bibliothèque partagée lance `mvn sonar:sonar` par PRÉFIXE. Maven ne
           résout un préfixe que depuis ses groupes de plugins par défaut ou
           depuis un plugin DÉCLARÉ dans le pom. sonar-maven-plugin vit dans
           org.sonarsource.scanner.maven : sans cette déclaration, l'étape Sonar
           échoue avec « No plugin found for prefix 'sonar' ». -->
      <plugin>
        <groupId>org.sonarsource.scanner.maven</groupId>
        <artifactId>sonar-maven-plugin</artifactId>
        <version>3.9.1.2184</version>
      </plugin>

      <!-- MÉCANISME, PAS DÉTAIL D'EMPAQUETAGE.
           Les jars de dépendances sont copiés dans target/runtime/ puis placés
           dans l'image. Trivy scanne l'IMAGE, pas le dépôt : sans ces jars, son
           analyseur Java ne voit rien, et la fermeture de sécurité confirmée par
           deux scanners devient impossible à prouver. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>runtime-artifacts</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/runtime</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
